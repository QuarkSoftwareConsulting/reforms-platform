flowchart TB

    %% =========================
    %% DESARROLLO / REPOSITORIO
    %% =========================
    DEV["Equipo de desarrollo"]
    GH["GitHub<br/>Repositorio<br/>feature/* → develop → main"]

    DEV -->|"Push / Pull Request"| GH

    %% =========================
    %% VERCEL - FRONTEND
    %% =========================
    subgraph VERCEL["Vercel"]
        VP["Preview Deployments<br/>Pull Requests"]
        WEB["Production<br/>Next.js Web<br/>merge a main"]
        VEDGE["CDN · SSL · WAF · DDoS"]
        VP --> VEDGE
        WEB --> VEDGE
    end

    GH -->|"PR automático"| VP
    GH -->|"Merge a main<br/>deploy automático"| WEB

    %% =========================
    %% CI/CD BACKEND
    %% =========================
    GHA["GitHub Actions<br/>Backend CI/CD<br/>Lint · Tests · Build · Deploy"]

    GH -->|"PR / main<br/>validaciones backend"| GHA

    %% =========================
    %% GOOGLE CLOUD
    %% =========================
    subgraph GCP["Google Cloud Platform"]
        AR["Artifact Registry<br/>Imagen Docker API"]
        API["Cloud Run<br/>FastAPI API<br/>min-instances = 1"]
        SM["Secret Manager<br/>DB URL · Firebase config<br/>Stripe secrets · otros secretos"]
        GCS["Cloud Storage<br/>Imágenes · Documentos"]
        NAT["VPC + Cloud NAT<br/>IP de salida estática<br/>DECISIÓN DE EQUIPO / COSTO"]
        ARMOR["Opcional futuro<br/>External Load Balancer<br/>+ Cloud Armor"]
    end

    GHA -->|"Build & Push"| AR
    AR -->|"Deploy revision"| API

    %% =========================
    %% DIGITALOCEAN
    %% =========================
    subgraph DO["DigitalOcean"]
        DB["Managed PostgreSQL<br/>+ PostGIS<br/>TLS · Backups"]
    end

    %% =========================
    %% FIREBASE
    %% =========================
    subgraph FIREBASE["Firebase"]
        AUTH["Firebase Authentication<br/>Usuarios · ID Tokens<br/>Custom Claims / Roles"]
    end

    %% =========================
    %% SERVICIOS EXTERNOS
    %% =========================
    subgraph EXT["Servicios externos"]
        STRIPE["Stripe<br/>Checkout · Payments · Webhooks"]
    end

    %% =========================
    %% USUARIOS Y FLUJOS
    %% =========================
    USERS["Usuarios<br/>Navegador"]

    USERS -->|"HTTPS"| VEDGE
    USERS -->|"Login / Registro"| AUTH

    VEDGE -->|"HTTPS REST<br/>Bearer ID Token"| API

    API -->|"Verifica ID Token / Claims"| AUTH
    SM -->|"Secrets runtime"| API
    API -->|"Objetos / Signed URLs"| GCS

    API --> NAT
    NAT -->|"PostgreSQL TLS<br/>Trusted static IP"| DB

    API -->|"Crear Checkout Session<br/>Stripe API"| STRIPE
    STRIPE -->|"Webhook firmado<br/>payment events"| API

    ARMOR -.->|"Protección adicional futura"| API

    %% =========================
    %% CONVENCIONES
    %% =========================
    NOTE["Convenciones:<br/>Línea sólida = flujo activo<br/>Línea punteada = opcional/futuro<br/>Vercel despliega frontend<br/>GitHub Actions despliega solo backend<br/>Stripe/Firebase = servicios externos administrados"]
