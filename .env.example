# ==========================================================================
# Reforma Hub - variables de entorno
# Copia este archivo a `apps/api/.env` y `apps/web/.env.local` segun la seccion.
# ==========================================================================

# ---------------------------- BACKEND (apps/api/.env) ---------------------
ENVIRONMENT=development
LOG_LEVEL=INFO

# Postgres + PostGIS (docker compose expone el 5432 del contenedor en el 5433)
DATABASE_URL=postgresql+asyncpg://reforma:reforma@localhost:5433/reforma_hub
TEST_DATABASE_URL=postgresql+asyncpg://reforma:reforma@localhost:5434/reforma_hub_test

# URL publica del frontend (se usa en los success_url/cancel_url de Stripe)
PUBLIC_WEB_URL=http://localhost:3010
CORS_ORIGINS=http://localhost:3010

# Reglas de negocio
LEAD_MAX_PURCHASES=3
PURCHASE_RESERVATION_TTL_MINUTES=30
DEFAULT_LEAD_PRICE_CENTS=500
DEFAULT_CURRENCY=EUR
PRIVACY_POLICY_VERSION=2026-01-v1

# Stripe (claves de test en https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=sk_test_xxx
# La imprime `stripe listen --forward-to localhost:8010/api/v1/webhooks/stripe`
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Firebase Auth (verificacion de ID tokens en el backend)
FIREBASE_PROJECT_ID=reforma-hub-dev
# Opcion A: ruta al service account JSON descargado de la consola de Firebase
GOOGLE_APPLICATION_CREDENTIALS=
# Opcion B: el JSON completo en una sola linea (util en CI / contenedores)
FIREBASE_CREDENTIALS_JSON=
# En local, con el emulador levantado, no hace falta service account:
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Almacenamiento: s3 por defecto en local; gcs para Cloud Run con ADC sin JSON.
STORAGE_BACKEND=s3
GCS_BUCKET=
GCS_SIGNED_URL_EXPIRES_SECONDS=900
# Solo se usan con STORAGE_BACKEND=s3 (MinIO / S3 / R2).
S3_ENDPOINT_URL=http://localhost:9000
S3_PUBLIC_BASE_URL=http://localhost:9000/reforma-hub-dev
S3_BUCKET=reforma-hub-dev
S3_REGION=auto
S3_ACCESS_KEY_ID=reformahub
S3_SECRET_ACCESS_KEY=reformahub123

# ---------------------------- FRONTEND (apps/web/.env.local) --------------
NEXT_PUBLIC_API_URL=http://localhost:8010
NEXT_PUBLIC_DEFAULT_LOCALE=es

NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=reforma-hub-dev.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=reforma-hub-dev
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=reforma-hub-dev.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
# Apunta el SDK del navegador al emulador de Auth en desarrollo
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=http://127.0.0.1:9099
